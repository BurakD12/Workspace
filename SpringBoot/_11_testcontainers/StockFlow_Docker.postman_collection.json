    {
      "name": "1. The stock ledger",
      "item": [
        {
          "name": "bob (CLERK) records IN 250 -> 201, quantityAfter 250, recordedBy bob, no Location header",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}/movements",
              "host": [
                "{{baseUrl}}"
