                "movements"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clerkToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"type\": \"IN\", \"quantity\": 250, \"reason\": \"Initial delivery\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"quantityAfter is 250\", () => pm.expect(b.quantityAfter).to.eql(250));",
                  "pm.test(\"recordedBy comes from the token\", () => pm.expect(b.recordedBy.username).to.eql(\"bob\"));",
                  "pm.test(\"no Location header (a ledger line is not individually addressable)\",",
                  "    () => pm.expect(pm.response.headers.has(\"Location\")).to.eql(false));"
                ]
              }
            }
          ]
        },
