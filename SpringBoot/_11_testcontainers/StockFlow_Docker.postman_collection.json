              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}",
                "movements"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clerkToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"type\": \"IN\", \"quantity\": 0}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));",
                  "const b = pm.response.json();",
                  "pm.test(\"ProblemDetail title is \\\"Validation failed\\\"\", () => pm.expect(b.title).to.eql(\"Validation failed\"));",
                  "pm.test(\"field error on quantity\", () => pm.expect(pm.response.json().errors.quantity).to.eql(\"Quantity must be greater than zero\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "product now shows 220 on hand and is NOT low stock (220 > 100)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clerkToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"quantityOnHand 220\", () => pm.expect(b.quantityOnHand).to.eql(220));",
                  "pm.test(\"lowStock false\", () => pm.expect(b.lowStock).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "ledger: 2 lines, newest first",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}/movements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}",
                "movements"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clerkToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"two ledger lines\", () => pm.expect(b.totalElements).to.eql(2));",
                  "pm.test(\"newest first (the OUT)\", () => pm.expect(b.content[0].type).to.eql(\"OUT\"));",
                  "pm.test(\"the running balance reads straight off the history\",",
                  "    () => pm.expect(b.content.map(m => m.quantityAfter)).to.eql([220, 250]));"
                ]
              }
            }
          ]
        },
        {
          "name": "low-stock filter excludes it",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
