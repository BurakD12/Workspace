                "movements"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clerkToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"type\": \"OUT\", \"quantity\": 500}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));",
                  "const b = pm.response.json();",
                  "pm.test(\"ProblemDetail title is \\\"Insufficient stock\\\"\", () => pm.expect(b.title).to.eql(\"Insufficient stock\"));",
                  "pm.test(\"detail names the numbers\", () => pm.expect(pm.response.json().detail).to.include(\"220 on hand, 500 requested\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "bob records quantity 0 -> 400 validation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
